# Database
# Local development: leave DATABASE_URL empty and SQLite will be used.
# Supabase/Render: paste the PostgreSQL connection string here.
DATABASE_URL=
DB_STORAGE=./database.sqlite
DB_POOL_MAX=5

# JWT
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# SMTP transacional (Brevo SMTP ou outro provedor compatível)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost:5173

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
